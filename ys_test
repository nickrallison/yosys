#!/usr/bin/env python3
"""Regenerate and run the default Yosys test suites, optionally under a subdirectory."""

import argparse
import os
from pathlib import Path
import subprocess
import sys


def result_files(suites):
	return {path for suite in suites for path in suite.rglob("*.result") if path.is_file()}


def main():
	tests = Path(__file__).resolve().parent / "tests"
	parser = argparse.ArgumentParser(description=__doc__)
	parser.add_argument("build_dir", type=Path)
	parser.add_argument("test_dir", type=Path, nargs="?", default=tests)
	args = parser.parse_args()

	build = args.build_dir.resolve(strict=True)
	scope = args.test_dir.resolve(strict=True)
	if not build.is_dir() or not os.access(build / "yosys", os.X_OK):
		parser.error(f"Expected a build directory containing executable yosys: {build}")
	if not scope.is_dir() or not scope.is_relative_to(tests):
		parser.error(f"Test directory must be inside {tests}")

	make = [
		"make", "--no-print-directory", "-C", str(tests),
		f"BUILD_DIR={build}", f"YOSYS={build / 'yosys'}",
		"ENABLE_VERIFIC=0", "ENABLE_FUNCTIONAL_TESTS=0",
	]
	# Ask the top-level Makefile for its default suite list.
	query = subprocess.run(
		[*make, "-s", "-f", "Makefile", "-f", "-", "ys-test-dirs"],
		input=".PHONY: ys-test-dirs\nys-test-dirs:\n\t@printf '%s\\n' $(MK_TEST_DIRS)\n",
		text=True, stdout=subprocess.PIPE, check=True,
	)
	suites = [
		(tests / directory).resolve() for directory in query.stdout.splitlines()
		if (tests / directory).resolve().is_relative_to(scope)
	]
	if not suites:
		parser.error(f"No default test suites found in {scope}")

	# Preserve results outside the selected suites.
	for path in result_files(suites):
		path.unlink()
	jobs = 32 # len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else os.cpu_count() or 1
	directories = " ".join(f"./{suite.relative_to(tests).as_posix()}" for suite in suites)
	# The top-level target regenerates each suite's Makefile before running it.
	status = subprocess.run([
		*make, "-k", f"-j{jobs}", f"MK_TEST_DIRS={directories}", "makefile-tests",
	]).returncode

	results = {path: path.read_text().strip() for path in result_files(suites)}
	passed = sum(result == "PASS" for result in results.values())
	failed = sorted(path for path, result in results.items() if result != "PASS")
	print("==========================")
	print(f"Tests: {len(results)}\nPassed: {passed}\nFailed: {len(failed)}")
	print("==========================")
	if failed:
		print("\nFailing tests:")
		for path in failed:
			print(path.relative_to(tests).with_suffix(""))
	if not results:
		print("No test results produced.", file=sys.stderr)
	return int(bool(status or failed or not results))


if __name__ == "__main__":
	try:
		sys.exit(main())
	except (OSError, subprocess.CalledProcessError) as error:
		print(f"ys_test: {error}", file=sys.stderr)
		sys.exit(1)
	except KeyboardInterrupt:
		sys.exit(130)
